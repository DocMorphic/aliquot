flowchart LR

    classDef ui fill:#1e3a8a,stroke:#1e40af,color:#fff
    classDef phase fill:#0f766e,stroke:#115e59,color:#fff
    classDef ai fill:#7c2d12,stroke:#9a3412,color:#fff
    classDef ext fill:#4b5563,stroke:#6b7280,color:#fff
    classDef store fill:#312e81,stroke:#3730a3,color:#fff

    User([Hypothesis]):::ui
    Validate[Validate + rewrite if vague]:::phase
    Classify[Classify domain]:::phase
    LitQC[Lit QC]:::phase
    Generate[Generate grounded plan]:::phase
    Verify[Verify catalogs]:::phase
    Confidence[Confidence score]:::phase
    Plan([Plan]):::ui
    Review([Scientist Review]):::ui
    Reviser[Reviser Haiku]:::ai
    Guidelines[(Domain guidelines)]:::store
    OpenAlex[(OpenAlex)]:::ext
    Tavily[(Tavily catalogs)]:::ext
    DB[(Supabase)]:::store

    User --> Validate --> Classify --> LitQC
    LitQC <--> OpenAlex
    LitQC --> Generate
    Tavily --> Generate
    Guidelines -. few-shot .-> Generate
    Generate --> Verify
    Verify <--> Tavily
    Verify --> Confidence --> Plan
    Plan --> Review
    Review -- this experiment --> Reviser --> Plan
    Review -- general guideline --> Guidelines

    LitQC -. persist .-> DB
    Verify -. persist .-> DB
    Review -. persist .-> DB
